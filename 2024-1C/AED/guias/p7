            str[] actividades
        }

        class dia{
            Int[24] horas

            NuevoDia(){
                horas = [0,0,0,0,....,0] //24 valores en 0
            }
            
            //O(1) pues horas es acot
            ActividadEnHorario(inicio, fin){
                for(i = inicio; i < fin; i++){
                    horas[i] += 1
                }
            }
        }

        class Actividad{
            int id
            int dia
            int inicio
            int fin
            NuevaActividad(id1, dia1, inicio1, fin1){
                this.id = id1
                this.dia = dia1
                this.inicio = inicio1
                this.fin = fin1
            }
        }

        //O(log d)
        RegistrarActividad(id, dia, inicio, fin){
            //O(1)
            objetoAct = NuevaActividad(id, dia, inicio, fin)
            Actividades.insertar(id, objetoAct) // al nodo le agrega el objeto del 2do parametro
            //O(log d)
            if(Dias.pertenece(dia)){
                //O(log d)
                objetoDia = Dias.buscar(dia)
            }
            else{
                objetoDia = NuevoDia()
            }
            //O(1)
            objetoDia.ActividadEnHorario(inicio, fin)
        }

        //O(log a)
        VerActividad(Id){
            //O(log(a))
            Objactividad = Actividades.buscar(Id)
            return Objactividad.dia + Objactividad.inicio + Objactividad.fin
        }

        //O(1)
        AgregarTag(idAct, tag){
            //tags acotados => O(1)
            objTag = tags.buscar(tag)
            //O(1)
            objTag.actividades.append(idAct)
        }

        //O(log d)
        HoraMasOcupada(dia){
            //O(log d)
            objetoDia = dias.buscar(dia)
            return max(objetoDia.horas) //horas es acotada => O(1)
        }

        //O(1)
        ActividadesPorTag(tag){
            //O(1)
            objetoTag = tags.buscar(tag)
            return objetoTag.actividades
        }


    }

