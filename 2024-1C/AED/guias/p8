    ordenarMultiplos(arr, k){
        subseqs = int[arr.length][k]

        //o(n)
        for(i = 0; i < arr.length; i++){
            subseqs[i][0] = arr[i]
        }

        //o(nk)
        for(sub in subseqs){
            for(i = 1; i <= k; i++){
                sub[i-1] = sub[0] * i
            }
        }
        

        while(subseqs.length > 1){
            merge(subseqs[0], subseqs[1])
        }
    }
    
