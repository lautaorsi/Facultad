    palabrasConPrefijo(prefijo){
        actual = raiz
        palabras = []
        for(letra in prefijo){
            actual = actual.seq[letra]  //llegamos a la ult letra
        }

        if(letra.significado != null){
            palabras.concatenar(prefijo) //si esa ult letra tiene significado la agregamos
        }

        for(letra in actual.seq){ //para cada hijo de esa ult letra
            if(letra.valido == true && letra.significado != null){ //si tiene significado
                nuevapalabra = prefijo + letra
                palabras.concatenar(nuevapalabra) //agregamos la nueva palabra
                palabras.concatenar(letra.palabrasConPrefijo()) //buscamos nuevas palabras con ese prefijo
            }
            if(letra.valido == true && letra.significado == null){ // si es valido pero sin significado == faltan letras para completar la palabra
                palabras.concatenar(letra.palabrasConPrefijo("")) //agregamos la recursion desde esa nueva letra y con prefijo ""
            }
        }
        return palabras
    }

