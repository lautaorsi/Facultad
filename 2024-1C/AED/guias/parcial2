    MasContaminados(seq, k){
        sensores = new trie    
        seq.mergesort() //O n log n en base a que tan recientes son
        for(elem in seq){ //O(n)
            
            //O(1)
            sensores.agregar(elem[0]) //agrega el nodo
            
            //O(1)
            objetoSensor = sensores.buscasr(elem[0]) //retorna el objeto dentro del nodo que contiene obs sumaMediciones, obs cantMediciones y obs MedicionMasReciente
            
            //O(1)
            if(objetoSensor.cantMediciones < k){
                objetoSensor.cantMediciones += 1 
                objetoSensor.sumaMediciones += elem[2] 
                if(objetoSensor.MedicionMasReciente == 0){ //se inicializa en 0 y esta guarda solo se cumple en la primera aparicion del sensor (que ya esta ordenado de mas reciente a menos reciente) entonces el primer elem es el mas grande y el unico a guardar
                    objetoSensor.MedicionMasReciente = elem[1] 
                }
            }   

        }

        nuevaseqTupla = []

        for(elem in seq){ //O(n)
            //O(1)
            Sensor = sensores.buscar(elem[0])
            //O(1)
            nuevaseqTupla.agregar((Sensor.MedicionMasReciente, Sensor.sumaMediciones, elem))
        }

        //O(n log n)
        nuevaseqTupla.mergeSort() //en base a la primera componente
        nuevaseqTupla.mergeSort() //en base a la 2da componente
        return nuevaseqTupla.soloNombre()



        
